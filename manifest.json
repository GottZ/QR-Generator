{
  "name": "QR Generator",
  "short_name": "QR Gen",
  "description": "Generate QR codes instantly for URLs, text, WiFi, contacts, SEPA, PayPal and more.",
  "start_url": "/qr/",
  "scope": "/qr/",
  "id": "/qr/",
  "display": "standalone",
  "prefer_related_applications": false,
  "orientation": "any",
  "theme_color": "#3cb856",
  "background_color": "#2a2a2e",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "https://gottz.de/qr/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
